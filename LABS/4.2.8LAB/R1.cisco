enable
configure terminal

hostname R1
no ip domain-lookup
domain-name POD71R1.local

banner motd #
LABS/4.2.8LAB
#

line console 0
password cisco
login

line vty 0 15
password cisco
transport input ssh
login local
exit

clock timezone CET 1

service password-encryption

enable secret cisco

username ciscouser privilege 15 secret cisco
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

interface GigabitEthernet 0/0/1
description Main trunk interface to Sw1
no shutdown

interface GigabitEthernet 0/0/1.3
description Management VLAN
ip address 192.168.3.1 255.255.255.0
encapsulation dot1Q 3

interface GigabitEthernet 0/0/1.4
description Operations VLAN
ip address 192.168.4.1 255.255.255.0
encapsulation dot1Q 4

interface GigabitEthernet 0/0/1.8
description Native VLAN
ip address 192.168.8.1 255.255.255.0
encapsulation dot1Q 8

end
wr

