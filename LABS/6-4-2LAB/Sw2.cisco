enable
configure terminal

hostname Sw2
no ip domain-lookup
ip domain-name POD71Sw2.local

banner motd #
LABS/6-4-2LAB
#

line console 0
password cisco
login

line vty 0 15
password cisco
transport input ssh
login local

service password-encryption

enable secret class

clock timezone CET 1

username ciscouser privilege 15 secret cisco
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

spanning-tree portfast bpduguard default
errdisable recovery cause bpduguard
errdisable recovery interval 400

interface vlan 10
description Management
ip address 192.168.10.12 255.255.255.0
no shutdown

vlan 10
name Management
exit

interface vlan 20
description Clients
no shutdown
exit

vlan 20
name Clients
exit

interface vlan 999
description ParkingLot
no shutdown

vlan 999
name Parking_Lot
exit

interface vlan 1000
description Native
no shutdown

vlan 1000
name Native_
exit

interface fastEthernet 0/16
switchport access vlan 20
no shutdown

interface range fastEthernet  0/1 - 2
switchport mode trunk
switchport trunk allowed vlan 10,20
switchport trunk native vlan 1000
switchport nonegotiate
no spanning-tree portfast
no spanning-tree bpduguard
channel-group 1 mode desirable
no shutdown
exit