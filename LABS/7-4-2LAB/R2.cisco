enable 
configure terminal

hostname R2
no ip domain-lookup
Ip domain-name POD71R2.local

line console 0
password cisco
login

line vty 0 15
password cisco
transport input ssh
login local
exit

service password-encryption

username ciscouser privilege 15 secret cisco
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

enable secret class

clock timezone CET 1

int gi0/0/0
description Link to Link
ip address 10.0.0.2 255.255.255.252
no shutdown

int gi0/0/1
description Link to LAN
ip address 172.168.1.1 255.255.255.0
ip helper-address 10.0.0.1
no shutdown
exit 

ip route 0.0.0.0 0.0.0.0 10.0.0.1


