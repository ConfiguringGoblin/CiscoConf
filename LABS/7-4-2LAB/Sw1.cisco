enable
configure terminal

hostname SW1
no ip domain-lookup
ip domain-name POD71SW1.local

line console 0
password cisco
login

line vty 0 15
password cisco
transport input ssh
login local
exit

service password-encryption

username ciscouser privilege 15 secret cisco
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

enable secret class

clock timezone CET 1

spanning-tree portfast bpduguard default 

int ran fa0/1 - 24
switchport mode access
switchport access vlan 999
shutdown

vlan 100
name clients

vlan 200
name Management

int vlan 200
ip add 192.168.200.1 255.255.255.0

vlan 999
name Parking_Lot

vlan 1000
name Native_

int fa0/6
switchport access vlan 100
no shutdown

int fa0/5
no switchport access vlan 999
switchport mode trunk
switchport trunk allowed vlan 100,200
switchport trunk native vlan 1000
no spanning-tree bpduguard
no spanning-tree portfast
no shutdown

ip default-gateway 192.168.100.1