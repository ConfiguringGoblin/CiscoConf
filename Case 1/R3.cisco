enable 
configure terminal

hostname R3
no ip domain-lookup
Ip domain-name POD71R3.local

line console 0
password 0 4
login

line vty 0 15
password 0 4
transport input ssh
login local
exit

service password-encryption

username admin privilege 15 secret 0 4
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

enable secret 0 4

clock timezone CET 1

ipv6 unicast-routing

int gi0/0/0
description link to R1
ip address 10.0.0.6 255.255.255.252
no shutdown

int gi0/0/1
no shutdown

int gi0/0/1.10
description Administration 
encapsulation dot1Q 10
ip address 192.168.10.3 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 10 ip 192.168.10.1
standby 10 priority 100
standby 10 preempt
standby 10 track g0/0/0 20

int gi0/0/1.20
description Salg
encapsulation dot1Q 20
ip address 192.168.20.3 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 20 ip 192.168.20.1
standby 20 priority 100
standby 20 preempt
standby 20 track g0/0/0 20

int gi0/0/1.30
description IT
encapsulation dot1Q 30
ip address 192.168.30.3 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 30 ip 192.168.30.1
standby 30 priority 110
standby 30 preempt
standby 30 track g0/0/0 20

int gi0/0/1.40
description Drift_og_NOC
encapsulation dot1Q 40
ip address 192.168.40.3 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 40 ip 192.168.40.1
standby 40 priority 100
standby 40 preempt
standby 40 track g0/0/0 20

int gi0/0/1.99
description Management
encapsulation dot1Q 99
ip address 192.168.99.3 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 99 ip 192.168.99.1
standby 99 priority 110
standby 99 preempt
standby 99 track g0/0/0 20

int gi0/0/1.999
description Native
encapsulation dot1Q 999 native
exit


ip route 0.0.0.0 0.0.0.0 gi0/0/0 10.0.0.5
ip route 10.0.0.0 255.255.255.252 g0/0/0 10.0.0.5