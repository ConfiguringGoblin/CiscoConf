enable 
configure terminal

hostname R2
no ip domain-lookup
Ip domain-name POD71R2.local

banner motd #
LAYER3.
No unauthorized access!
#

line console 0
password  0 4
login

line vty 0 15
password  0 4
transport input ssh
login local
exit

service password-encryption

username admin privilege 15 secret 0 4
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

enable secret 0 4

clock timezone CET 1

ipv6 unicast-routing

int gi0/0/0
description link to R1
ip address 10.0.0.2 255.255.255.252
no shutdown

int gi0/0/1
no shutdown

track 10 interface GigabitEthernet0/0/0 line-protocol

int gi0/0/1.10
description Administration 
encapsulation dot1Q 10
ip address 192.168.10.2 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 10 ip 192.168.10.1
standby 10 priority 110
standby 10 preempt
standby 10 track 10 decrement 20


int gi0/0/1.20
description Salg
encapsulation dot1Q 20
ip address 192.168.20.2 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 20 ip 192.168.20.1
standby 20 priority 110
standby 20 preempt
standby 20 track 10 decrement 20

int gi0/0/1.30
description IT
encapsulation dot1Q 30
ip address 192.168.30.2 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 30 ip 192.168.30.1
standby 30 priority 100
standby 30 preempt
standby 30 track 10 decrement 20

int gi0/0/1.40
description Drift_og_NOC
encapsulation dot1Q 40
ip address 192.168.40.2 255.255.255.0
ip helper-address 192.168.201.111
standby version 2
standby 40 ip 192.168.40.1
standby 40 priority 110
standby 40 preempt
standby 40 track 10 decrement 20

int gi0/0/1.99
description Management
encapsulation dot1Q 99
ip address 192.168.99.2 255.255.255.0
ip helper-address 10.0.0.1
standby version 2
standby 99 ip 192.168.99.1
standby 99 priority 100
standby 99 preempt
standby 99 track 10 decrement 20

int gi0/0/1.210
description PVE_Management
encapsulation dot1Q 210
ip address 192.168.210.2 255.255.255.0
ip helper-address 192.168.210.111
standby version 2
standby 210 ip 192.168.210.1
standby 210 priority 110
standby 210 preempt
standby 210 track 10 decrement 20

int gi0/0/1.201
description VM_Management
encapsulation dot1Q 201
ip address 192.168.201.2 255.255.255.0
ip helper-address 192.168.201.111
standby version 2
standby 201 ip 192.168.201.1
standby 201 priority 110
standby 201 preempt
standby 201 track 10 decrement 20

int gi0/0/1.202
description SEC_Management
encapsulation dot1Q 202
ip address 192.168.202.2 255.255.255.0
ip helper-address 192.168.202.111
standby version 2
standby 202 ip 192.168.202.1
standby 202 priority 110
standby 202 preempt
standby 202 track 10 decrement 20

ip route 0.0.0.0 0.0.0.0 gi0/0/0 10.0.0.1
ip route 10.0.0.0 255.255.255.252 g0/0/0 10.0.0.1