ena
conf t

hostname R1
enable secret 0 4


banner motd #
EDGY guy numba 1.
No unauthorized access!
#

no ip domain-lookup
Ip domain-name POD71R1.local

line console 0
password 4
login

line vty 0 15
password 4
transport input ssh
login local
exit

service password-encryption

username admin privilege 15 secret 0 4
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

int Gi0/0/0
description Link to WAN
ip add 172.18.x.y
ip nat outside
no shutdown

int Gi0/0/1
description Link to R2
ip add 10.0.0.1 255.255.255.252
ip nat inside
no shutdown

int Gi0/0/2
description Link to R3
ip add 10.0.0.5 255.255.255.252
ip nat inside
no shutdown
exit

access-list 1 permit any
ip nat inside source list 1 interface Gi0/0/0 overload

ip dhcp excluded-address 192.168.10.1 - 192.168.10.9
ip dhcp pool VLAN10ADMIN
network 192.168.10.0 255.255.255.0
default-router 172.18.x.y
dns-server 10.100.100.10
exit

ip dhcp excluded-address 192.168.20.1 - 192.168.20.9
ip dhcp pool VLAN20SALES
network 192.168.20.0 255.255.255.0
default-router 172.18.x.y
dns-server 10.100.100.10
exit

ip dhcp excluded-address 192.168.30.1 - 192.168.30.9
ip dhcp pool VLAN30IT
network 192.168.30.0 255.255.255.0
default-router 172.18.x.y
dns-server 10.100.100.10
exit

ip dhcp excluded-address 192.168.30.1 - 192.168.30.9
ip dhcp pool VLAN40NOC
network 192.168.40.0 255.255.255.0
default-router 172.18.x.y
dns-server 10.100.100.10
exit

Service dhcp

ip route 192.168.0.0 255.255.0.0 Gi0/0/1 10.0.0.2 5
ip route 192.168.0.0 255.255.0.0 Gi0/0/2 10.0.0.6 10
ip route 0.0.0.0 0.0.0.0 Gi0/0/0