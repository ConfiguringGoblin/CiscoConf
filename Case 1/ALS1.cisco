enable
configure terminal

! Basic configurations
hostname ALS1
no ip domain-lookup
Ip domain-name POD71-ALS1.local

enable secret 0 4

line console 0
password 0 4
login

line vty 0 15
password 0 4
transport input ssh
login local
exit

service password-encryption

username admin privilege 15 secret 0 4
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

clock timezone CET 1

banner motd #
Access Layer Switch 1.
No unauthorized access!
#

spanning-tree portfast bpduguard default


! VLANs
vlan 10
name Administration
exit

vlan 20
name Salg
exit

vlan 30
name IT
exit

vlan 40
name Drift_og_NOC
exit

vlan 99
name Management
exit

vlan 999
name Native
exit

vlan 1000
name Blackhole
exit


! Management interface
int vlan 99
ip add 192.168.99.6 255.255.255.0
description Management SVI.
exit

ip default-gateway 192.168.99.1


! Close all interfaces (security)
int ran gi0/0
shutdown
exit

int ran gi1/0/1 - 24
switchport mode access
switchport access vlan 1000
shutdown
exit

int ran gi1/1/1 - 4
switchport mode access
switchport access vlan 1000
shutdown
exit


! DLS1 link
int ran gi1/0/21-22
channel-group 1 mode desirable
no switchport access vlan 1000
description Link to DLS1.
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99
exit

int port-channel 1
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99
switchport nonegotiate
description Link to DLS1.
exit


! DLS2 link
int ran gi1/0/23-24
channel-group 2 mode desirable
no switchport access vlan 1000
description Link to DLS2.
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99
exit

int port-channel 2
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99
switchport nonegotiate
exit


! Device interfaces
int gi1/0/13
switchport mode access
switchport access vlan 10
description Link to Administration VLAN.
no shutdown
switchport nonegotiate
exit

int gi1/0/15
switchport mode access
switchport access vlan 20
description Link to Salg VLAN.
no shutdown
switchport nonegotiate
exit

int gi1/0/17
switchport mode access
switchport access vlan 30
description Link to IT VLAN.
no shutdown
switchport nonegotiate
exit

int gi1/0/19
switchport mode access
switchport access vlan 40
description Link to Drift og NOC VLAN.
no shutdown
switchport nonegotiate
exit


! Port security
int ran gi1/0/1 - 20
switchport port-security
switchport port-security maximum 5
switchport port-security mac-address sticky
switchport port-security violation restrict
ip dhcp snooping limit rate 6
spanning-tree portfast
spanning-tree bpduguard enable
exit

int ran gi1/1/1 - 4
switchport port-security
switchport port-security maximum 5
switchport port-security mac-address sticky
switchport port-security violation restrict
ip dhcp snooping limit rate 6
spanning-tree portfast
spanning-tree bpduguard enable
exit


! DHCP snooping
ip dhcp snooping
ip dhcp snooping vlan 10,20,30,40
no ip dhcp snooping information option

int ran port-channel 1-2
ip dhcp snooping trust
exit

int ran port-channel 1-2
ip dhcp snooping trust
ip arp inspection trust
exit


! DAI
ip arp inspection vlan 10,20,30,40
ip arp inspection validate src-mac
ip arp inspection validate dst-mac
ip arp inspection validate ip
no ip dhcp snooping information option

int ran port-channel 1-2
ip arp inspection trust
exit