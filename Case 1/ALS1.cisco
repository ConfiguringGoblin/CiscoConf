enable
configure terminal

hostname ALS1
no ip domain-lookup
Ip domain-name POD71-ALS1.local

enable secret 0 4

line console 0
password 0 4
login

line vty 0 15
password 0 4
transport input ssh
login local
exit

service password-encryption

username admin privilege 15 secret 0 4
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

clock timezone CET 1

banner motd #
Access Layer Switch 1.
No unauthorized access!
#

spanning-tree portfast bpduguard default

vlan 10
name Administration
exit

vlan 20
name Salg
exit

vlan 30
name IT
exit

vlan 40
name Drift_og_NOC
exit

vlan 99
name Management
exit

vlan 999
name Native
exit

vlan 1000
name Blackhole
exit



int vlan 99
ip add 192.168.99.6 255.255.255.0
exit


int ran gi0/0
switchport mode access
switchport access vlan 1000
shutdown
exit

int ran gi1/0/1 - 24
switchport mode access
switchport access vlan 1000
shutdown
exit

int ran gi1/1/1 - 4
switchport mode access
switchport access vlan 1000
shutdown
exit



int gi1/0/13
switchport mode access
switchport access vlan 10
description Link to Administration VLAN.
no shutdown
exit

int gi1/0/15
switchport mode access
switchport access vlan 20
description Link to Salg VLAN.
no shutdown
exit

int gi1/0/17
switchport mode access
switchport access vlan 30
description Link to IT VLAN.
no shutdown
exit

int gi1/0/19
switchport mode access
switchport access vlan 40
description Link to Drift og NOC VLAN.
no shutdown
exit

int ran gi1/0/21-22
no switchport access vlan 1000
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99
description Link to DLS1.
no shutdown
exit

int ran gi1/0/23-24
no switchport access vlan 1000
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99
description Link to DLS2.
no shutdown
exit

int ran fa0/21-24
channel-group 3 mode desirable
exit


ip default-gateway 192.168.99.1