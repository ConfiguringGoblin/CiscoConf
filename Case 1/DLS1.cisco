enable
configure terminal

hostname DLS1
no ip domain-lookup
Ip domain-name POD71-DLS1.local

enable secret 0 4

line console 0
password 0 4
login

line vty 0 15
password 0 4
transport input ssh
login local
exit

service password-encryption

username admin privilege 15 secret 0 4
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

clock timezone CET 1

banner motd #
Distribution Layer Switch 1.
No unauthorized access!
#

spanning-tree portfast bpduguard default

vlan 10
name Administration
exit

vlan 20
name Salg
exit

vlan 30
name IT
exit

vlan 40
name Drift_og_NOC
exit

vlan 99
name Management
exit

vlan 999
name Native
exit

vlan 1000
name Blackhole
exit

spanning-tree vlan 10,20,40 root primary
spanning-tree vlan 30,99 root secondary

int vlan 99
ip add 192.168.99.4 255.255.255.0
exit

int ran fa0/1 - 24
switchport mode access
switchport access vlan 1000
shutdown
exit


int ran fa0/21-23
no switchport access vlan 1000
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99
description Link to DLS2.
no shutdown
exit

int ran fa0/21-22
description Link to ALS1.
exit

int ran fa0/23
description R2.
exit

int ran gi0/1-2
no switchport access vlan 1000
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,40,99
description Link to DLS2.
no shutdown
exit

int ran fa0/21-22
channel-group 3 mode desirable
exit


ip default-gateway 192.168.99.1