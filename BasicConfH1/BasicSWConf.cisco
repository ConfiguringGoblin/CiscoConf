enable
configure terminal

hostname [Hostname]
no ip domain-lookup
Ip domain-name [DomainName]

enable secret [Password]

line console 0
password [Password]
login

line vty [Lines]
password [Password]
transport input ssh
login local
exit

service password-encryption

username [Username] privilege 15 secret [Password]
crypto key generate rsa general-keys modulus 2048
ip ssh version 2

banner motd #
[banner]
#

int Vlan [VLAN_ID]
name [Vlan Description]
ip addr [IPv4 addr] [Subnet_Mask]
no shutdown

interface [interface_name]
description access
switchport mode [mode]
switchport access vlan [VLAN_ID]

interface [interface_name]
description portfast
spanning-tree portfast 
//portfast is for access ports only since it enbables bpdu guard if it is enabled in the STP protocol and other portfast features
//you can enbale "spanning-tree portfast bpduguard default" as a global command to enable bpdu guard on all access ports with portfast enabled. If you want to enable it on a specific port, use "spanning-tree bpduguard enable" under the interface configuration mode.


interface [interface_name]
switchport mode trunk
switchport nonegotiate 
switchport trunk native vlan [VLAN_ID]
switchport trunk allowed vlan [VLAN_IDs]

//for older switches use switch port encapsulation dot1q


interface range [interface_range]
channel-group [PortChannel_ID] mode [mode]
exit
interface Port-channel [PortChannel_ID]
switchport mode trunk
switchport trunk allowed vlan [VLAN_ID]
no shutdown

//Set the speed of a port and duplex mode.
interface [interface_name]
speed 100
duplex full


exit

ip default-gateway [DefaultGateway]