ena
conf t

hostname [Hostname]
enable secret [Password]
banner motd #
[Banner]
#

no ip domain-lookup
Ip domain-name [DomainName]

line console 0
password [Password]
login

line vty [Lines]
password [Password]
transport input ssh
login local
exit

service password-encryption

username admin privilege 15 secret [Password]
crypto key generate rsa general-keys modulus 2048
ip ssh version 2


int fa0/0
description link to link
ip addr [IPv4] [Subnet_Mask]
no shutdown

int fa0/1
description link to lan (nat inside)
ip nat inside 
ip address [IPv4] [Subnet_Mask]
no shutdown

int fa0/0/0
Description link to wan (nat outside)
ip nat outside
ip add dhcp
no shutdown

int tunnel0
ip addr [IPv4] [Subnet_Mask]    
tunnel source fa0/0
tunnel destination [IPv4 Destination]
ip nat inside
no shutdown 
exit

access-list 1 permit any
ip nat inside source list 1 interface fa0/0/0 overload

ip route [Destination_Network] [Subnet_Mask] [Next_Hop_IP]

ip dhcp excluded-address [Excluded_IP_Range]
ip dhcp pool [Pool_Name]
network [Network] [Subnet_Mask]
default-router [Default_Gateway]
dns-server [DNS_Server]
exit
service dhcp

end

wr
